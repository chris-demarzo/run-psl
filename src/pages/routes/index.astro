---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import EmptyState from '../../components/EmptyState.astro'; import { formatDate } from '../../lib/dates'; import { isStale } from '../../lib/content-freshness.mjs'; const routes=await getCollection('routes');
---
<BaseLayout title="Routes" description="Public parks, paths, and places to run around Port St. Lucie."><header class="page-head"><div class="shell"><p class="eyebrow">Choose your terrain</p><h1>Routes</h1><p>Public places to run, with sourced surface and amenity details. Conditions can change—use judgment on every run.</p><span class="verified">Re-verification in progress</span></div></header><section class="content-section shell"><div class="notice"><strong>Freshness:</strong> Details may have changed since the date shown. Follow the official source for current access and amenities.</div><div class="notice"><strong>Safety:</strong> Verify park hours, weather, lighting, traffic, and current conditions before running. Carry water; these sources do not confirm runner-oriented potable water.</div>{routes.length ? <div class="card-grid">{routes.map(({data:r})=><article class="card"><p class="eyebrow">{r.surface}</p><h2>{r.name}</h2><p>{r.location}</p>{r.distance&&<span class="pill">{r.distance}</span>}<div class="meta">{r.amenities.map(a=><span class="pill">{a}</span>)}</div>{r.safety&&<p>{r.safety}</p>}<small>{isStale(r.verifiedDate) ? 'Needs re-verification — last checked' : 'Last verified'} {formatDate(r.verifiedDate)}</small><a class="source" href={r.url} rel="noreferrer">Official location information →</a></article>)}</div> : <EmptyState title="Routes are being documented" message="We will not publish mileage or amenities until they are supported by a public source." />}</section></BaseLayout>
