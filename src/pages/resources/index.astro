---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import EmptyState from '../../components/EmptyState.astro'; import { formatDate } from '../../lib/dates'; const resources=await getCollection('resources');
---
<BaseLayout title="Local Resources" description="Running stores, clubs, organizers, and public resources around Port St. Lucie."><header class="page-head"><div class="shell"><p class="eyebrow">Useful local links</p><h1>Local Resources</h1><p>Organizations and places that help Treasure Coast runners train, connect, and find events.</p><span class="verified">Last verified July 15, 2026</span></div></header><section class="content-section shell">{resources.length ? <div class="card-grid">{resources.map(({data:r})=><article class="card"><p class="eyebrow">{r.category}</p><h2>{r.name}</h2><p>{r.description}</p><p>{r.location}</p><small>Last verified {formatDate(r.verifiedDate)}</small><a class="source" href={r.url} rel="noreferrer">Visit official source →</a></article>)}</div> : <EmptyState title="Resources are being verified" message="We are checking first-party links before publishing this directory." />}</section></BaseLayout>
