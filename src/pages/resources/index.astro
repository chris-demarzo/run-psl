---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import EmptyState from '../../components/EmptyState.astro'; import { formatDate } from '../../lib/dates'; import { isStale } from '../../lib/content-freshness.mjs'; const resources=await getCollection('resources');
---
<BaseLayout title="Local Resources" description="Running stores, clubs, organizers, and public resources around Port St. Lucie."><header class="page-head"><div class="shell"><p class="eyebrow">Useful local links</p><h1>Local Resources</h1><p>Organizations and places that help Treasure Coast runners train, connect, and find events.</p><span class="verified">Re-verification in progress</span></div></header><section class="content-section shell"><div class="notice"><strong>Freshness:</strong> Details may have changed since the date shown. Follow the official source for current information.</div>{resources.length ? <div class="card-grid">{resources.map(({data:r})=><article class="card"><p class="eyebrow">{r.category}</p><h2>{r.name}</h2><p>{r.description}</p><p>{r.location}</p><small>{isStale(r.verifiedDate) ? 'Needs re-verification — last checked' : 'Last verified'} {formatDate(r.verifiedDate)}</small><a class="source" href={r.url} rel="noreferrer">Visit official source →</a></article>)}</div> : <EmptyState title="Resources are being verified" message="We are checking first-party links before publishing this directory." />}</section></BaseLayout>
