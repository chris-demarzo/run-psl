---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import EmptyState from '../../components/EmptyState.astro'; import { formatDate } from '../../lib/dates'; const groups=await getCollection('groups');
---
<BaseLayout title="Group Runs" description="Recurring public group runs around Port St. Lucie."><header class="page-head"><div class="shell"><p class="eyebrow">Find your people</p><h1>Group Runs</h1><p>Recurring runs with public organizer information. Confirm details with the host before traveling.</p><span class="verified">Last verified July 15, 2026</span></div></header><section class="content-section shell">{groups.length ? <div class="card-grid">{groups.map(({data:g})=><article class="card"><p class="eyebrow">{g.schedule}</p><h2>{g.name}</h2><p>{g.location}</p>{g.pace&&<span class="pill">{g.pace}</span>}{g.note&&<p>{g.note}</p>}<small>Last verified {formatDate(g.verifiedDate)}</small><a class="source" href={g.url} rel="noreferrer">Check with the organizer →</a></article>)}</div> : <EmptyState title="Group schedules are being checked" message="Recurring runs change. We are confirming current schedules with public organizer sources." />}</section></BaseLayout>
