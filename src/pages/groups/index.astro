---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import EmptyState from '../../components/EmptyState.astro'; import { formatDate } from '../../lib/dates'; import { dateInSiteTimeZone, isStale } from '../../lib/content-freshness.mjs';
const today = dateInSiteTimeZone();
const groups=(await getCollection('groups')).filter(({data}) => !data.expiresDate || data.expiresDate >= today);
---
<BaseLayout title="Group Runs" description="Recurring public group runs around Port St. Lucie."><header class="page-head"><div class="shell"><p class="eyebrow">Find your people</p><h1>Group Runs</h1><p>Recurring runs with public organizer information. Confirm details with the host before traveling.</p><span class="verified">Re-verification in progress</span></div></header><section class="content-section shell"><div class="notice"><strong>Freshness:</strong> Details may have changed since the date shown. Check with the organizer before traveling.</div>{groups.length ? <div class="card-grid">{groups.map(({data:g})=><article class="card"><p class="eyebrow">{g.schedule}</p><h2>{g.name}</h2><p>{g.location}</p>{g.pace&&<span class="pill">{g.pace}</span>}{g.note&&<p>{g.note}</p>}<small>{isStale(g.verifiedDate) ? 'Needs re-verification — last checked' : 'Last verified'} {formatDate(g.verifiedDate)}</small><a class="source" href={g.url} rel="noreferrer">Check with the organizer →</a></article>)}</div> : <EmptyState title="Group schedules are being checked" message="Recurring runs change. We are confirming current schedules with public organizer sources." />}</section></BaseLayout>
