---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import EmptyState from '../../components/EmptyState.astro'; import { formatDate } from '../../lib/dates';
const events=(await getCollection('events')).sort((a,b)=>a.data.date.localeCompare(b.data.date));
---
<BaseLayout title="Events" description="Upcoming running events around Port St. Lucie and the Treasure Coast."><header class="page-head"><div class="shell"><p class="eyebrow">Plan your next start line</p><h1>Events</h1><p>Upcoming races and community running events, linked to the organizer or registration source.</p><span class="verified">Last verified July 24, 2026</span></div></header><section class="content-section shell">{events.length ? <div class="card-grid">{events.map(({data:e})=><article class="card"><p class="eyebrow">{formatDate(e.date)} · {e.time}</p><h2>{e.name}</h2><p>{e.location}</p><p>Organized by {e.organizer}</p><div class="meta">{e.distances.map(d=><span class="pill">{d}</span>)}</div><small>Last verified {formatDate(e.verifiedDate)}</small><a class="source" href={e.url} rel="noreferrer">Official event information →</a></article>)}</div> : <EmptyState title="Events are being verified" message="We will publish an event only after checking its date and organizer source." />}</section></BaseLayout>
