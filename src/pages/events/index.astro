---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import EmptyState from '../../components/EmptyState.astro'; import { formatDate } from '../../lib/dates';
import { dateInSiteTimeZone, isStale } from '../../lib/content-freshness.mjs';
const today = dateInSiteTimeZone();
const events=(await getCollection('events')).filter(({data}) => data.date >= today).sort((a,b)=>a.data.date.localeCompare(b.data.date));
---
<BaseLayout title="Events" description="Upcoming running events around Port St. Lucie and the Treasure Coast."><header class="page-head"><div class="shell"><p class="eyebrow">Plan your next start line</p><h1>Events</h1><p>Upcoming races and community running events, linked to the organizer or registration source.</p></div></header><section class="content-section shell">{events.length ? <div class="card-grid">{events.map(({data:e})=><article class="card"><p class="eyebrow">{formatDate(e.date)} · {e.time}</p><h2>{e.name}</h2><p>{e.location}</p><p>Organized by {e.organizer}</p><div class="meta">{e.distances.map(d=><span class="pill">{d}</span>)}</div><small>{isStale(e.verifiedDate) ? 'Needs re-verification — last checked' : 'Last verified'} {formatDate(e.verifiedDate)}</small><a class="source" href={e.url} rel="noreferrer">Official event information →</a></article>)}</div> : <EmptyState title="No upcoming events are currently verified" message="Past events are archived automatically. New listings will appear only after their date and organizer source are checked." />}</section></BaseLayout>
