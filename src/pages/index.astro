---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { dateInSiteTimeZone } from '../lib/content-freshness.mjs';
const [events,groups,routes,resources]=await Promise.all([getCollection('events'),getCollection('groups'),getCollection('routes'),getCollection('resources')]);
const today = dateInSiteTimeZone();
const upcomingEvents = events.filter(({data}) => data.date >= today);
const currentGroups = groups.filter(({data}) => !data.expiresDate || data.expiresDate >= today);
const sections=[['/events/','Events',upcomingEvents.length,'Upcoming races and community events'],['/groups/','Group runs',currentGroups.length,'Recurring runs and ways to connect'],['/routes/','Routes',routes.length,'Public paths, parks, and places to run'],['/resources/','Resources',resources.length,'Local organizations and useful links']];
---
<BaseLayout title="Local running, one useful place" description="Find running events, group runs, routes, and resources around Port St. Lucie."><section class="hero shell"><div><p class="eyebrow">Port St. Lucie · Treasure Coast</p><h1>Run PSL.<span> Find your next run.</span></h1><p class="hero-copy">A mobile-friendly guide to local races, recurring group runs, public routes, and runner resources—with sources and verification dates.</p><div class="cta-row"><a class="button" href="/events/">Explore events</a><a class="button secondary" href="/routes/">Browse routes</a></div></div><aside class="hero-aside"><span class="verified">Content review in progress</span><p>Schedules and conditions change. Follow each listing to its public source before heading out.</p></aside></section><section class="shell"><div class="section-bar"><h2>Explore the directory</h2><a href="/about/">How verification works →</a></div><div class="directory-nav">{sections.map(([href,label,count,copy])=><a class="directory-link" href={String(href)}><b>{count}</b><div><strong>{label}</strong><span>{copy}</span></div></a>)}</div></section><section class="content-section shell"><div class="empty-state"><p class="eyebrow">Directory status</p><h2>Built from public sources.</h2><p>Past events are archived automatically. Older group-run, route, and resource details remain visible with re-verification warnings and links to their original sources.</p><a class="source" href="/events/">Check upcoming events →</a></div></section></BaseLayout>
