---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const [events,groups,routes,resources]=await Promise.all([getCollection('events'),getCollection('groups'),getCollection('routes'),getCollection('resources')]);
const sections=[['/events/','Events',events.length,'Upcoming races and community events'],['/groups/','Group runs',groups.length,'Recurring runs and ways to connect'],['/routes/','Routes',routes.length,'Public paths, parks, and places to run'],['/resources/','Resources',resources.length,'Local organizations and useful links']];
---
<BaseLayout title="Local running, one useful place" description="Find running events, group runs, routes, and resources around Port St. Lucie."><section class="hero shell"><div><p class="eyebrow">Port St. Lucie · Treasure Coast</p><h1>Run PSL.<span> Find your next run.</span></h1><p class="hero-copy">A mobile-friendly guide to local races, recurring group runs, public routes, and runner resources—with sources and verification dates.</p><div class="cta-row"><a class="button" href="/events/">Explore events</a><a class="button secondary" href="/routes/">Browse routes</a></div></div><aside class="hero-aside"><span class="verified">Last verified July 15, 2026</span><p>Schedules and conditions change. Follow each listing to its public source before heading out.</p></aside></section><section class="shell"><div class="section-bar"><h2>Explore the directory</h2><a href="/about/">How verification works →</a></div><div class="directory-nav">{sections.map(([href,label,count,copy])=><a class="directory-link" href={String(href)}><b>{count}</b><div><strong>{label}</strong><span>{copy}</span></div></a>)}</div></section><section class="content-section shell"><div class="empty-state"><p class="eyebrow">Building the first edition</p><h2>Verified listings are on the way.</h2><p>The site structure is live. Initial entries will appear only after their dates, schedules, and source links pass review.</p></div></section></BaseLayout>
